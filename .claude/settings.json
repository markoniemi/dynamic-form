{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(tsc:*)",
      "Bash(java:*)",
      "Bash(bash -c*)",
      "Bash(ls:*)",
      "Bash(aws:*)",
      "Bash(terraform:*)",
      "Bash(xargs grep:*)",
      "mcp__idea__*",
      "mcp__playwright__*",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/deploy.env)",
      "Read(**/deploy.*.env)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \".claude/hooks/stop-check.ps1\"",
            "timeout": 150,
            "statusMessage": "Checking compilation..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "ponytail@ponytail": true
  }
}

{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.moderne.ai)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:www.baeldung.com)",
      "WebFetch(domain:katyella.com)",
      "WebFetch(domain:stevenpg.com)",
      "WebFetch(domain:docs.openrewrite.org)",
      "WebFetch(domain:ankurm.com)",
      "WebFetch(domain:serdaralkancode.medium.com)",
      "PowerShell(git *)",
      "Bash(Get-ChildItem -Recurse -Filter \"*oauth*\" -ErrorAction SilentlyContinue)",
      "Bash(Select-Object FullName)",
      "Bash(gh api *)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "PowerShell(Get-ChildItem .claude -Recurse -Force | Where-Object { -not $_.PSIsContainer } | Select-Object -ExpandProperty FullName; \"---- rules dir? ----\"; Test-Path .claude\\\\rules; \"---- docs ----\"; Get-ChildItem docs -Recurse | Select-Object -ExpandProperty Name)",
      "PowerShell(Get-ChildItem .claude\\\\skills -Recurse -Filter SKILL.md | ForEach-Object { \"=== $\\($_.FullName.Replace\\($PWD.Path,''\\)\\) ===\"; Get-Content $_.FullName -TotalCount 8 })",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)"
    ]
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Include Spring Boot defaults for colors and patterns -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- surefire sets logging.exception-depth=short to keep unit-test output small -->
  <springProperty name="EX_DEPTH" source="logging.exception-depth" defaultValue="full"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%highlight(%-5level %logger{1}: %msg%n%ex{${EX_DEPTH}})</pattern>
    </encoder>
  </appender>

  <!-- Root Logger -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <!-- Application specific loggers -->
  <logger name="com.example" level="DEBUG"/>
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.hibernate" level="ERROR"/>
  <logger name="com.gargoylesoftware" level="OFF"/>
  <logger name="DefaultCssErrorHandler" level="OFF"/>
</configuration>
